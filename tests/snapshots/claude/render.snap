#!/usr/bin/env bash
# GENERATED by ai-agent-setup — DO NOT EDIT. Run `ai-agent-setup build` to regenerate.
# Sources:
#   - core/hooks/protect-secrets.sh
#   - core/hooks/manifest.yaml
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
input="$(cat)"

# Extract the relevant field(s) from Claude's event JSON (tool_input.*).
payload="$(printf '%s' "$input" | AAS_FIELDS="file_path,command,notebook_path" node -e 'let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>{try{const j=JSON.parse(s);const ti=(j&&j.tool_input)||{};for(const f of (process.env.AAS_FIELDS||"").split(",")){if(ti[f]){process.stdout.write(String(ti[f]));break;}}}catch(e){}});' 2>/dev/null)"

"$DIR/protect-secrets.sh" "$payload"
code=$?

# Neutral script exits non-zero to block; Claude blocks on exit code 2.
if [[ $code -ne 0 ]]; then
  exit 2
fi
exit 0


